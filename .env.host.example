# Copy to .env.host locally; never commit that file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Can also be set by an admin in Settings → AI model (write-only, wins over env).
DEEPSEEK_API_KEY=
# Optional: DEEPSEEK_MODEL=deepseek-flash  DEEPSEEK_BASE_URL=https://api.deepseek.com
QUEUE_ENV=development
API_BIND=127.0.0.1
API_PORT=8787
APP_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5175
# No team defaults have been selected. This is a JSON array of page URLs.
SOURCE_DEFAULT_URLS=[]
# Optional administrator restriction, NOT a source preference. Blank = public HTTPS.
SOURCE_RESTRICT_DOMAINS=
# Legacy SOURCE_ALLOWED_DOMAINS is ignored. Remove it from existing .env.host files.

# Deployment (trusted network)
# LOCAL_API_BIND=0.0.0.0
# LOCAL_API_PORT=8788
# SERVE_STATIC=1
# STATIC_DIR=dist

# Task queue / event library / collector (M1–M3). Defaults live under .local/.
# Override them only to run an isolated instance; never point two processes at
# the same files.
# LOCAL_DATA_FILE=.local/domel.json
# AGENT_DATA_DIR=.local
# TASKS_FILE=.local/tasks.json
# EVENTS_FILE=.local/events.json
# SOURCES_FILE=.local/source-registry.json
# DOCUMENTS_FILE=.local/documents.json
# RECIPES_FILE=.local/recipes.json
# AGENT_TRANSCRIPT_FILE=.local/agent/transcripts.json
# AGENT_WORKSPACE_ROOT=.local/workspaces
# ASSISTANT_SESSION_DIR=.local/assistant
# SOURCE_SEED_FILE=seed/sources-cn.json
# GEO_FILE=seed/geo-cn.json
# COMPANY_SEED_FILE=seed/company-domel.json
# TASK_CONCURRENCY=1              # single worker by default
# DOMAIN_INTERVAL_MS=5000         # per-domain token bucket, never below 5000
# SOURCE_SCHEDULER_MS=30000       # scheduler tick interval

# MinerU (optional)
# Web search for finding event official websites (see docs/SEARCH_ENGINES.md).
# auto = DeepSeek search tool when the model is DeepSeek, otherwise the local URL.
# WEB_SEARCH_PROVIDER=auto|deepseek|searxng|custom|none
# WEB_SEARCH_URL=http://127.0.0.1:8080
# SEARXNG_URL=http://127.0.0.1:8080
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_LANGUAGE=zh-CN
# WEB_SEARCH_TIMEOUT_MS=12000

# OCR: the default vision OCR uses the configured AI model (no extra key).
# Optional MinerU provider (official token or self-hosted service) can be enabled here
# or in Settings → Document parsing. OCR then falls back to agent adaptive fetch.
# OCR_MAX_PAGES=5
# OCR_MAX_EMBEDDED_IMAGES=2      # webpage <img> OCR limit
# OCR_WEB_IMAGES_TEXT_LIMIT=4000 # OCR page images when text is below this
# OCR_WEB_IMAGES_ALWAYS=0        # set 1 to always OCR embedded page images
# OCR_MAX_PDF_IMAGES=3           # embedded images in a text-layer PDF
# MINERU_PROVIDER=official
# MINERU_API_TOKEN=            # can also be filled in Settings → Document parsing (write-only)
# MINERU_API_BASE=https://mineru.net/api/v4
# MINERU_MODEL_VERSION=vlm    # pipeline|vlm; vlm is recommended for accuracy
# OCR_TIMEOUT_MS=90000
# AGENT_FETCH_FALLBACK=1
# MinerU (optional)
# MINERU_PROVIDER=none|official|local
# MINERU_LOCAL_URL=http://127.0.0.1:8000
# MINERU_API_BASE=https://mineru.net/api/v4
# MINERU_API_TOKEN=
# The settings page can override provider/endpoint/token; the token is
# write-only and stored in .local/agent-config.json.
