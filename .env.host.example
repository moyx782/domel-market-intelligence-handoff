# Copy to .env.host locally; never commit that file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
QUEUE_ENV=development
API_BIND=127.0.0.1
API_PORT=8787
APP_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5175
# No team defaults have been selected. This is a JSON array of page URLs.
SOURCE_DEFAULT_URLS=[]
# Optional administrator restriction, NOT a source preference. Blank = public HTTPS.
SOURCE_RESTRICT_DOMAINS=
# Legacy SOURCE_ALLOWED_DOMAINS is ignored. Remove it from existing .env.host files.

# Deployment (trusted network)
# LOCAL_API_BIND=0.0.0.0
# LOCAL_API_PORT=8788
# SERVE_STATIC=1
# STATIC_DIR=dist

# MinerU (optional)
# MINERU_PROVIDER=none|official|local
# MINERU_LOCAL_URL=http://127.0.0.1:8000
# MINERU_API_BASE=https://mineru.net/api/v4
# MINERU_API_TOKEN=
