# Single-user demo is the default when Supabase settings are empty:
#   npm run demo:api   (local API on 127.0.0.1:8788)
#   npm run dev        (frontend on 127.0.0.1:5174)
# Set VITE_APP_MODE=host only for the Supabase multi-user host API.
VITE_APP_MODE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty means 8788 for the local demo and 8787 for the host API.
VITE_BACKEND_URL=
VITE_EXECUTION_MODE=host
